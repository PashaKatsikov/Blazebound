<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Partners routinely send HTTP push / redirect URLs; a "false" base
         breaks cold-start taps silently (see gray_part_pitfalls.md §17). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
